<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/normal.css">
  <link rel="stylesheet" href="/css/small.css" media="screen and (max-width: 768px)">
  <link rel="stylesheet" href="/css/large.css" media="screen and (min-width: 1200px)">
</head>
<body>
  <nav>
    <!-- Hidden checkbox for toggle -->
    <input type="checkbox" id="menu-toggle">

    <!-- Hamburger icon -->
    <label for="menu-toggle" class="menu-icon">☰</label>
        
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/organizations">Organizations</a></li>
      <li><a href="/projects">Projects</a></li>
      <li><a href="/categories">Categories</a></li>

      <% if (isLoggedIn) { %>
        <li><a href="/logout">Logout</a></li>
      <% } else { %>
        <li><a href="/register">Register</a></li>
        <li><a href="/login">Login</a></li>
      <% } %>

      <% if (user && user.role_name === 'admin') { %>
        <!-- Admin-only global links -->
        <li><a href="/new-organization">Add New Organization</a></li>
        <li><a href="/projects/new">Add New Project</a></li>
        <li><a href="/categories/new">Add New Category</a></li>
        <li><a href="/users">Manage Users</a></li>
      <% } %>
    </ul>
  </nav>


  
 <!-- Flash messages -->
<div class="flash-messages">
  <% if (flash && flash.success && flash.success.length > 0) { %>
    <% flash.success.forEach(msg => { %>
      <p class="flash-success">
        <span><%= msg %></span>
        <span class="flash-close" onclick="this.parentElement.style.display='none'">&times;</span>
      </p>
    <% }) %>
  <% } %>

  <% if (flash && flash.error && flash.error.length > 0) { %>
    <% flash.error.forEach(msg => { %>
      <p class="flash-error">
        <span><%= msg %></span>
        <span class="flash-close" onclick="this.parentElement.style.display='none'">&times;</span>
      </p>
    <% }) %>
  <% } %>
</div>
