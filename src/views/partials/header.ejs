<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/normal.css">
    <link rel="stylesheet" href="/css/small.css" media="screen and (max-width: 600px)">
    <link rel="stylesheet" href="/css/large.css" media="screen and (min-width: 601px)">

</head>
<body>
    <nav>

        <!-- Hidden checkbox for toggle -->
    <input type="checkbox" id="menu-toggle">

    <!-- Hamburger icon -->
    <label for="menu-toggle" class="menu-icon">☰</label>
        
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/organizations">Organizations</a></li>
            <li><a href="/projects">Projects</a></li>
            <li><a href="/categories">Categories</a></li>
        </ul>
    </nav>

    <% const messages = flash(); %>
    <% Object.keys(messages).forEach(type => { %>
        <% if (messages[type].length > 0) { %>
            
                <% messages[type].forEach(msg => { %>
                    <%= msg %>
                <% }); %>
            
        <% } %>
    <% }); %>