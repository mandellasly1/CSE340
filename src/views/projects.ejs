<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>


<% if (user && user.role_name === 'admin') { %>
        <!-- Admin-only action: Add new project -->
        <a href="/projects/new">Add New Project</a>
    <% } %>

    <ul>
        <% projects.forEach(project => { %>
            <li>
                <a href="/project/<%= project.project_id %>"><%= project.name %></a>

                <% if (user && user.role_name === 'admin') { %>
                    <!-- Admin-only actions: Edit project and categories -->
                    <a href="/project/<%= project.project_id %>/edit">Edit Project</a>
                    <a href="/project/<%= project.project_id %>/categories">Edit Project Categories</a>
                <% } %>
            </li>
        <% }); %>
    </ul>

  
  <p>Here are the next upcoming service projects:</p>

  <div class="projects-container">
    <% projects.forEach(project => { %>
      <div class="project-box 
        <% if (project.organization_name === 'BrightFuture Builders') { %> brightfuture <% } %>
        <% if (project.organization_name === 'GreenHarvest Growers') { %> greenharvest <% } %>
        <% if (project.organization_name === 'UnityServe Volunteers') { %> unityserve <% } %>">
        
        <!-- Project title now links to project details -->
        <h3>
          <a href="/project/<%= project.project_id %>"><%= project.title %></a>
        </h3>

        <!-- Date (use project.project_date instead of project.project.date if that’s your column name) -->
        <p>Date: <%= project.project_date ? new Date(project.project_date).toDateString() : 'No date available' %></p>

        <!-- Organization name now links to organization details -->
        <p>
          <em>
            <a href="/organization/<%= project.organization_id %>">
              <%= project.organization_name %>
            </a>
          </em>
        </p>
      </div>
    <% }); %>
  </div>

  <p>
    <a href="/new-project">Add a New Service Project</a>
  </p>

</main>
<%- include('partials/footer') %>
